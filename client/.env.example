# Only needed if the API is hosted on a DIFFERENT domain from the client.
# On Vercel (client + API on one domain) leave this UNSET — the client then
# calls the relative path /api, which avoids CORS entirely.
# Local dev also leaves it unset: vite.config.js proxies /api to :5000.
# VITE_API_URL=https://your-api-host.example.com/api

# Firebase Web SDK config — Project Settings > General > Your apps > SDK setup.
# These are public by design (they identify the project, they don't authorise).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
