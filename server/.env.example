# Local dev only — Vercel assigns the port itself.
PORT=5000

# Atlas: Connect > Drivers. URL-encode any special characters in the password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/peer-project-hub

# Firebase Admin — Project Settings > Service accounts > Generate new private key.
# FIREBASE_PRIVATE_KEY must keep its literal \n escapes and be wrapped in quotes.
# Copy the value only: a trailing comma from the downloaded JSON breaks PEM parsing.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. Restricts the API to these origins (comma-separated). Leave unset
# when the client and API share a domain, as they do on Vercel.
# CORS_ORIGIN=https://your-app.vercel.app
